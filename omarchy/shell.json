{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "officeryoda.menu"
        },
        {
          "id": "officeryoda.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 180
  },
  "plugins": [
    {
      "id": "officeryoda.image-picker"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "tourSeen": true,
      "openAs": "panel",
      "design": "poster"
    },
    {
      "id": "officeryoda.background"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.image-picker",
    "omarchy.lock",
    "omarchy.menu",
    "omarchy.background"
  ],
  "cloneSourceRestores": [
    "officeryoda.image-picker",
    "io.github.sirjul1337.lock-explorer",
    "officeryoda.menu",
    "officeryoda.background"
  ]
}
