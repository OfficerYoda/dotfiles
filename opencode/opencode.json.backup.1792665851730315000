{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    }
  ],
  "share": "disabled",
  "lsp": true,
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-anthropic"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-openai"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-google"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "hai-litellm"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "github-copilot"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "openrouter"
      }
    ]
  },
  "providers": {
    "anthropic": {
      "name": "HAI Anthropic",
      "settings": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
