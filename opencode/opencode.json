{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "share": "disabled",
  "provider": {
    "anthropic": {
      "options": {
        "name": "HAI Anthropic",
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/anthropic/v1"
      }
    },
    "google": {
      "name": "HAI Gemini",
      "options": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/gemini/v1beta"
      }
    },
    "openai": {
      "name": "HAI OpenAI",
      "options": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/openai/v1"
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-coding-nvfp4": {
          "name": "Qwen 3.6 35B-A3B Coding"
        },
        "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q5_K_XL": {
          "name": "Qwen 3.8 27B"
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-sonnet-4-6",
  "plugin": [
    "/Users/I767799/.config/skills/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "mcp": {
    "forgejo-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "{env:GO_PATH}/bin/forgejo-mcp",
        "--transport",
        "stdio",
        "--url",
        "https://forgejo.officeryoda.dev"
      ],
      "environment": {
        "FORGEJO_ACCESS_TOKEN": "{env:FORGEJO_MCP_SERVER}"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "/Users/I767799/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  }
}
