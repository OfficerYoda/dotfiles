{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "share": "disabled",
  "provider": {
    "anthropic": {
      "options": {
        "name": "HAI Anthropic",
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/anthropic/v1"
      }
    },
    "google": {
      "name": "HAI Gemini",
      "options": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/gemini/v1beta"
      }
    },
    "openai": {
      "name": "HAI OpenAI",
      "options": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/openai/v1"
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-coding-nvfp4": {
          "name": "Qwen 3.6 35B-A3B Coding"
        },
        "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q5_K_XL": {
          "name": "Qwen 3.8 27B"
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "model": "anthropic/claude-opus-4-6",
  "small_model": "anthropic/claude-sonnet-4-6",
  "plugin": [
    "/Users/I767799/.config/skills/ponytail/.opencode/plugins/ponytail.mjs"
  ]
