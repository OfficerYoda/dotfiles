{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],
  "share": "disabled",
  "lsp": true,
  "experimental": {
    "subagent_depth": 2
  },
  "providers": {
    "anthropic": {
      "name": "HAI Anthropic",
      "settings": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/anthropic/v1"
      }
    },
    "google": {
      "name": "HAI Gemini",
      "settings": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/gemini/v1beta"
      }
    },
    "openai": {
      "name": "HAI OpenAI",
      "settings": {
        "apiKey": "{env:HAI_PROXY_API_KEY}",
        "baseURL": "http://localhost:6655/openai/v1"
      }
    },
    "ollama": {
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-coding-nvfp4": {
          "name": "Qwen 3.6 35B-A3B Coding"
        },
        "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL": {
          "name": "Qwen 3.8 27B"
        }
      }
    }
  },
  "agents": {
    "explore": {
      "model": "anthropic/claude-sonnet-4-6#low"
    },
    "general": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "model": "anthropic/claude-sonnet-4-6",
  "plugins": [
    "/Users/I767799/.config/skills/ponytail/.opencode/plugins/ponytail",
    "/Users/I767799/.config/opencode/plugins/rtk"
  ],
  "skills": ["/Users/I767799/.config/skills/ponytail/skills"],
  "mcp": {
    "servers": {
      "forgejo-mcp": {
        "disabled": false,
        "type": "remote",
        "url": "http://localhost:8677/mcp",
        "headers": {
          "Authorization": "Bearer {env:FORGEJO_MCP_SERVER}"
        }
      },
      "openrouter": {
        "type": "remote",
        "url": "https://mcp.openrouter.ai/mcp",
        "disabled": false
      }
    }
  }
}
