{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "anthropic",
    "openai",
    "google"
  ],
  "model": "anthropic/claude-sonnet-latest",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "name": "HAI Anthropic",
      "options": {
        "apiKey": "40c0440f-16e2-4063-8518-9a8468e26f1a",
        "baseURL": "http://localhost:6655/anthropic/v1"
      }
    },
    "google": {
      "name": "HAI Gemini",
      "options": {
        "apiKey": "40c0440f-16e2-4063-8518-9a8468e26f1a",
        "baseURL": "http://localhost:6655/gemini/v1beta"
      }
    },
    "openai": {
      "name": "HAI OpenAI",
      "options": {
        "apiKey": "40c0440f-16e2-4063-8518-9a8468e26f1a",
        "baseURL": "http://localhost:6655/openai/v1"
      }
    }
  },
  "share": "disabled"
}